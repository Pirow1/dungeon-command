# Copy to .env and fill in. Never commit .env — it is gitignored.

# ---- credentials (set at least one) ----
# OpenAI: needed for any gpt-* route below.
OPENAI_API_KEY=sk-...
# Anthropic: needed for any claude-* route below.
ANTHROPIC_API_KEY=sk-ant-...

# ---- per-call model routing ----
# The provider is inferred from the model id: claude-* goes to Anthropic,
# anything else to OpenAI. There is no separate provider switch.
#
# Defaults if unset:
#   ORDERS_MODEL=gpt-5-mini    (blocking call the player waits on)
#   MONSTER_MODEL=gpt-5-mini   (hidden behind the party animation)
#   NARRATOR_MODEL=gpt-5-nano  (one throwaway sentence, fire-and-forget)
#
# To run the character control on Claude instead:
#   ORDERS_MODEL=claude-haiku-4-5
#   MONSTER_MODEL=claude-haiku-4-5
#   NARRATOR_MODEL=claude-haiku-4-5
#
# Haiku 4.5 is the latency pick. claude-sonnet-5 and claude-opus-5 also work and
# are smarter, but default to adaptive thinking — the adapter holds them back
# with low effort, and they will still be slower on the blocking orders call.
# ORDERS_MODEL=
# MONSTER_MODEL=
# NARRATOR_MODEL=

# ---- demo insurance ----
# MOCK_LLM=1 serves canned-but-sensible responses with no API calls at all.
# MOCK_LLM=1

# API port (the Vite dev server proxies /api here).
# API_PORT=3001
